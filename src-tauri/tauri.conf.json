{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "beautiful-dynamo-viewer",
  "version": "0.1.0",
  "identifier": "com.eduartech.beautiful-dynamo-viewer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "beautiful-dynamo-viewer",
        "width": 2000,
        "height": 1200,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
     "updater": {
       "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3ODkyQkFFRjAwMkU4RkYKUldULzZBTHdyaXVKOTF5S3p0VXlHcmpXUTl5U0NsUUxuZVhBK0dJcm5FdmxnKys5RnR0L2R2T0QK",
       "endpoints": [
         "https://github.com/devcastech/beautiful-dynamo-viewer/releases/latest/download/latest.json"
       ],
       "windows": {
         "installMode": "passive"
       }
     }
  }
}
